        <mxCell id="e-standings-team" value="tocar na linha do time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#F9A825;endArrow=block;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tab-standings" target="team-detail">
