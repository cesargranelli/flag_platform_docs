        <mxCell id="e-hub-games" value="aba Jogos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#616161;endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="hub" target="tab-games">
