          <mxGeometry x="880" y="394" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="error404" value="Página não encontrada
errorBuilder (qualquer rota inválida)
· botão &quot;Voltar ao início&quot; → /live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;" vertex="1" parent="1">
          <mxGeometry x="880" y="502" width="360" height="56" as="geometry" />
        </mxCell>

        <!-- ================= SETAS: SHELL → ABAS ================= -->
        <mxCell id="e-shell-live" value="tocar aba" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#616161;endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="shell-container" target="tab-live">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-shell-camp" value="tocar aba
(com foco → /competition/:id)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#616161;endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="shell-container" target="tab-competition">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-shell-about" value="tocar aba" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#616161;endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="shell-container" target="tab-about">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= SETAS: CAMPEONATO ================= -->
