<mxfile host="app.diagrams.net" agent="flag-agent" version="24.0.0">
  <diagram id="flag-public-app-screens" name="Fluxo de Telas - Flag Public App">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= LEGENDA ================= -->
        <mxCell id="legend" value="LEGENDA" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg-aba" value="Aba da navegação principal (Shell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="220" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg-camp" value="Tela da área Campeonato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;" vertex="1" parent="1">
          <mxGeometry x="290" y="48" width="220" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg-stack" value="Tela empilhada (fora da Shell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1">
          <mxGeometry x="540" y="48" width="220" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg-erro" value="Tela de erro / estado vazio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E53935;" vertex="1" parent="1">
          <mxGeometry x="790" y="48" width="220" height="34" as="geometry" />
        </mxCell>
        <mxCell id="lg-decision" value="Decisão / condição" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;" vertex="1" parent="1">
          <mxGeometry x="1040" y="48" width="120" height="34" as="geometry" />
        </mxCell>

        <!-- ================= ZONA A: SHELL ================= -->
        <mxCell id="shell-container" value="PublicShell — StatefulShellRoute (IndexedStack)
navegação principal com 3 abas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="280" height="300" as="geometry" />
        </mxCell>

        <mxCell id="tab-live" value="Ao vivo
/live
LiveScreen
(timeline live score)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="220" height="64" as="geometry" />
        </mxCell>

        <mxCell id="tab-competition" value="Campeonato
/competition
CompetitionDetailScreen
