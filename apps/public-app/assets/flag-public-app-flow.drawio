          <mxGeometry x="40" y="470" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note-focus" value="Campeonato em foco (FocusedCompetition):
persistido em SharedPreferences.
· abrir app com foco → hub direto
· aba Campeonato → /competition/:id
· sem foco → lista /competition" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF9C4;strokeColor=#F9A825;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="280" height="96" as="geometry" />
        </mxCell>

        <mxCell id="note-stack" value="Voltar (back) nas telas empilhadas:
sistema de back do GoRouter — cada
