          <mxGeometry x="70" y="258" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="tab-about" value="Sobre
/about
AboutScreen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="70" y="362" width="220" height="44" as="geometry" />
        </mxCell>

        <mxCell id="shell-decision" value="Tela larga (>= 960px)?
NavigationRail : BottomBar" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- ================= ZONA B: CAMPEONATO ================= -->
