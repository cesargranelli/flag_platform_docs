        <!-- ================= NOTAS DE CENÁRIOS ================= -->
        <mxCell id="note-deeplink" value="Deep links do hub:
/competition/:id/games → aba Jogos
/competition/:id/results → aba Resultados
/competition/:id/standings → aba Classificação
